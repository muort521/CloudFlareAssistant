<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：让本应用在 Android 17 (API 37) 上也能被 HttpCanary 等抓包工具拦截。

  背景：
    从 Android 17 开始，系统对 targetSdk>=37 的应用默认启用 证书透明度 (CT) 校验，
    要求被信任的证书必须在公共 CT 日志中存在 SCT 记录。抓包工具（HttpCanary / Charles
    等）本地签发的 MITM 证书没有 CT 记录，因此会被系统 SSL 栈拒绝，表现为
    SSLV3_ALERT_CERTIFICATE_UNKNOWN / Certificate transparency failed。
    其它 targetSdk<37 的应用不受此限制，所以只有本应用抓不了包。

  本配置：
    - base-config：信任系统 CA（KSU/Magisk 挂载进去的抓包根证书即位于系统存储），
      并关闭 CT 校验。这样 debug / release 构建都能抓系统存储里的证书。
      注意：这里不放 <certificates src="user" />，否则会触发 lint 的
      AcceptsUserCertificates 错误（release 不允许信任用户 CA）并中断构建。
    - debug-overrides：仅在 debuggable 构建中额外信任用户 CA，便于把抓包根证书
      安装到用户存储时也能抓包；release 构建不受影响，保持安全。

  安全收紧选项（可选）：
    若不希望 release 也关闭 CT，可把 <certificateTransparency enabled="false" />
    也移入 <debug-overrides>，让 release 保持 Android 17 默认的 CT 校验。
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <certificateTransparency enabled="false" />
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
